# Firebaseプロジェクトの値に書き換えて .env.local としてコピーする
# （参照元: packages/web/src/common/firebaseConfig.ts）
NEXT_PUBLIC_FIREBASE_API_KEY=dummy-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=hinagata-next-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://hinagata-next-dev-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=hinagata-next-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=hinagata-next-dev.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
